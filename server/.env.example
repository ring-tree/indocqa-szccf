# 复制为 .env 后填入真实值；.env 不入库
# 模型网关：OpenAI 兼容接口，主供应商
INDOCQA_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
INDOCQA_LLM_API_KEY=sk-your-key-here
INDOCQA_LLM_MODEL=glm-4-flash

# 备用供应商（主供应商限流/故障时自动切换）
INDOCQA_LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
INDOCQA_LLM_BACKUP_API_KEY=sk-your-backup-key-here
INDOCQA_LLM_BACKUP_MODEL=deepseek-chat

# ============ 嵌入模型调用模式（显式选择，四选一）============
# local  = 进程内直调本地模型（权重在仓库 models/ 目录，随项目打包，零外部依赖）
# ollama = 调用本机 Ollama 服务（质量最优，需 ollama serve + 对应模型）
# minilm = chromadb 内置兜底（弱网下有秒级校验延迟，仅保底）
# auto   = Ollama 在运行则 ollama，否则 local
INDOCQA_EMBED_BACKEND=auto
# local 模式使用的模型与推理批量（大模型须调小批量，如 e5-large 用 8）
INDOCQA_EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
INDOCQA_EMBED_LOCAL_BATCH=32
# local 模式权重目录（默认仓库根 models/：便携布局随 git 分发，克隆即用；
# 未分发模型经镜像自动下载到同目录缓存布局，详见 README「嵌入模型调用模式」）
INDOCQA_EMBED_CACHE_DIR=../models
# ollama 模式使用的模型
INDOCQA_EMBED_OLLAMA_MODEL=bge-m3
INDOCQA_OLLAMA_BASE_URL=http://localhost:11434

# 存储路径（相对 server/ 运行目录）
INDOCQA_CHROMA_DIR=data/chroma
INDOCQA_CORPUS_DIR=../data/corpus
INDOCQA_UPLOAD_DIR=data/uploads

# 检索模式：fixed=固定参数基线；adaptive=意图路由+参数自适应
INDOCQA_RETRIEVAL_MODE=adaptive
