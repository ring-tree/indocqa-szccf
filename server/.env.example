# 复制为 .env 后填入真实值；.env 不入库
# 模型网关：OpenAI 兼容接口，主供应商
INDOCQA_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
INDOCQA_LLM_API_KEY=sk-your-key-here
INDOCQA_LLM_MODEL=glm-4-flash

# 备用供应商（主供应商限流/故障时自动切换）
INDOCQA_LLM_BACKUP_BASE_URL=https://api.deepseek.com/v1
INDOCQA_LLM_BACKUP_API_KEY=sk-your-backup-key-here
INDOCQA_LLM_BACKUP_MODEL=deepseek-chat
# 流式空闲超时（秒）：模型连接建立后超过该时间无新数据则中止并尝试下一个模型
INDOCQA_LLM_STREAM_IDLE_TIMEOUT=30
# 检索整体超时（秒）：嵌入/检索超时后返回可重试错误，避免请求无限挂起
INDOCQA_RETRIEVAL_TIMEOUT=45
# 可选：任意多套扩展模型，N 从 2 开始递增；前端模型下拉会显示全部可用模型
# INDOCQA_LLM_PROFILE_2_BASE_URL=https://api.example.com/v1
# INDOCQA_LLM_PROFILE_2_API_KEY=sk-your-key-here
# INDOCQA_LLM_PROFILE_2_MODEL=example-model
# INDOCQA_LLM_PROFILE_2_NAME=example-model
# 生成参数固化：温度与最大生成长度；JSON 模式单独设定以保证结构完整
INDOCQA_GENERATION_TEMPERATURE=0.0
INDOCQA_GENERATION_MAX_TOKENS=1024
INDOCQA_GENERATION_JSON_TEMPERATURE=0.0
INDOCQA_GENERATION_JSON_MAX_TOKENS=1536
# 内部自评等轻量调用（调用方不可覆盖）
INDOCQA_GENERATION_EVAL_TEMPERATURE=0.0
INDOCQA_GENERATION_EVAL_MAX_TOKENS=32

# ============ 嵌入模型调用模式（显式选择，四选一）============
# local  = 进程内直调本地模型（权重在仓库 models/ 目录，随项目打包，零外部依赖）
# ollama = 调用本机 Ollama 服务（质量最优，需 ollama serve + 对应模型）
# minilm = chromadb 内置兜底（弱网下有秒级校验延迟，仅保底）
# auto   = Ollama 在运行则 ollama，否则 local
INDOCQA_EMBED_BACKEND=auto
# local 模式使用的模型与推理批量（大模型须调小批量，如 e5-large 用 8）
INDOCQA_EMBED_LOCAL_MODEL=BAAI/bge-small-zh-v1.5
INDOCQA_EMBED_LOCAL_BATCH=32
# local 模式权重目录（默认仓库根 models/：便携布局随 git 分发，克隆即用；
# 未分发模型经镜像下载后自动归位为平铺真实文件，详见 README「嵌入模型调用模式」）
INDOCQA_EMBED_CACHE_DIR=../models
# ollama 模式使用的模型
INDOCQA_EMBED_OLLAMA_MODEL=bge-m3
INDOCQA_OLLAMA_BASE_URL=http://localhost:11434

# 存储路径（相对 server/ 运行目录）
INDOCQA_CHROMA_DIR=data/chroma
INDOCQA_CORPUS_DIR=../data/corpus
INDOCQA_UPLOAD_DIR=data/uploads
# 会话历史（SQLite 单文件；随 data/ 忽略）
INDOCQA_SESSION_DB=data/db/sessions.db
INDOCQA_SESSION_HISTORY_TURNS=6
INDOCQA_SESSION_TTL_DAYS=7

# 检索模式：fixed=固定参数基线；adaptive=意图路由+参数自适应
INDOCQA_RETRIEVAL_MODE=adaptive
# 弱命中闸门：最高向量相似度低于该值时按“库外问题”处理（配生成模型走通用回答，否则拒答）
INDOCQA_BOUNDARY_MIN_SIM=0.50

# ============ 上下文组装（去重/噪声/预算/溯源/模板）============
# on=生效；shadow=只统计不改变生成；off=回退旧拼接
INDOCQA_CONTEXT_MODE=on
INDOCQA_CONTEXT_ENABLED=true
# 目标模型上下文窗口与输出预留（严格预算 = window*safety - reserve）
INDOCQA_CONTEXT_WINDOW_TOKENS=32768
INDOCQA_CONTEXT_OUTPUT_RESERVE=1500
INDOCQA_CONTEXT_SAFETY_RATIO=0.90
INDOCQA_CONTEXT_ESTIMATE_MARGIN=1.08
# 分层配额（合计 1.0）：资料 / 历史 / 任务状态 / 用户画像
INDOCQA_CONTEXT_QUOTA_EVIDENCE=0.60
INDOCQA_CONTEXT_QUOTA_HISTORY=0.18
INDOCQA_CONTEXT_QUOTA_TASK=0.14
INDOCQA_CONTEXT_QUOTA_PERSONA=0.08
# 语义去重阈值与 SimHash 汉明距离
INDOCQA_CONTEXT_DEDUP_SEMANTIC=0.92
INDOCQA_CONTEXT_DEDUP_SEMANTIC_ENABLED=true
INDOCQA_CONTEXT_DEDUP_HAMMING=3
# 3-gram Jaccard 近重复兜底阈值（短中文段落对 SimHash 单字改动较敏感）
INDOCQA_CONTEXT_DEDUP_JACCARD=0.82
# 低相关噪声阈值：低于 top_score 的该比例视为噪声
INDOCQA_CONTEXT_NOISE_SCORE_RATIO=0.35
# 版本化约束模板
INDOCQA_CONTEXT_TEMPLATE_ID=kb-answer
INDOCQA_CONTEXT_TEMPLATE_VERSION=1
# 溯源清单持久化与画像开关
INDOCQA_CONTEXT_TRACE_PERSIST=true
INDOCQA_CONTEXT_PERSONA_ENABLED=true
